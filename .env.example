# Copy to .env for local development (never commit .env).
# Placeholders only — change credentials for anything beyond local Docker compose.

DATABASE_URL="postgresql://sim:sim@localhost:5432/sim?schema=public"
PORT=3000

# Milestone 4 — outbound delivery (n8n / webhook.site / generic webhook)
# Operator-controlled URL only (not set by API clients). Absolute http(s) required when set.
# Prefer HTTPS. Do not point at cloud metadata, internal admin panels, or localhost DB ports
# in shared environments. Missing URL → process attempt FAILED (server still starts).
DELIVERY_WEBHOOK_URL="https://example.com/webhook/your-path"
DELIVERY_TIMEOUT_MS=5000
# Optional shared secret sent as X-Webhook-Secret (leave empty to omit header)
DELIVERY_WEBHOOK_SECRET=

# Stuck PROCESSING reclaim (on-demand inside claim — no cron/worker)
# Age of lastAttemptAt after which PROCESSING may be re-claimed. Must be ≫ DELIVERY_TIMEOUT_MS
# so a healthy in-flight delivery is not stolen (default 5m vs 5s timeout).
PROCESSING_STALE_MS=300000
